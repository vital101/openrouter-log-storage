PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/openrouter_logs
WEBHOOK_SECRET=replace-me-with-a-long-random-string
WEBHOOK_SECRET_HEADER=X-Webhook-Signature
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=100
WEBHOOK_BODY_LIMIT=10mb
MAX_PROCESSING_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=1000
WORKER_BACKOFF_MAX_MS=300000
NODE_ENV=development