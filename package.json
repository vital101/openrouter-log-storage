{
  "name": "openrouter-log-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "dev:worker": "bun --hot src/worker/index.ts",
    "start": "bun src/server.ts",
    "start:worker": "bun src/worker/index.ts",
    "cleanup": "bun src/cleanup.ts",
    "migrate": "bun src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage && node scripts/check-coverage.mjs",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e"
  },
  "dependencies": {
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.4",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "esbuild",
    "fsevents",
    "cpu-features",
    "protobufjs",
    "ssh2"
  ]
}
